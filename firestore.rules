rules_version = '2';

// ============================================================
// 管理端：Firebase Auth（電子郵件＋密碼）
//   - 管理員以 admins/{uid} 判斷，須 enabled 且非 pending
//   - 總管理員可做任何事
//   - 區域窗口只能：核准自己區的「教室窗口」申請、停用/啟用、移除
//   - 學員端免登入：課程/名單/系列/設定可讀，進度可讀可寫
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasAdminDoc() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function myAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasAdminDoc()
        && myAdmin().get('enabled', false) == true
        && myAdmin().get('pending', false) == false;
    }
    function isSuper() {
      return isAdmin() && myAdmin().get('superAdmin', false) == true;
    }
    function myRegions() {
      return myAdmin().get('managedRegions', []);
    }
    function bootstrapped() {
      return exists(/databases/$(database)/documents/config/admin_root);
    }

    // 區域窗口核准：只能把「自己區的教室窗口申請」變成「該教室的窗口權限」
    function regionApproval() {
      return isAdmin()
        && resource.data.get('pending', false) == true
        && resource.data.get('superAdmin', false) == false
        && resource.data.get('request', {}).get('role', '') == 'classroom'
        && myRegions().hasAny([resource.data.get('request', {}).get('region', '')])
        && request.resource.data.get('pending', false) == false
        && request.resource.data.get('enabled', false) == true
        && request.resource.data.get('superAdmin', false) == false
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && request.resource.data.get('grants', []).size() == 1
        && request.resource.data.grants[0].get('role', '') == 'classroom'
        && request.resource.data.grants[0].get('region', '')
             == resource.data.get('request', {}).get('region', '')
        && request.resource.data.grants[0].get('classroom', '')
             == resource.data.get('request', {}).get('classroom', '');
    }

    // 區域窗口只能切換 enabled
    function regionToggle() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
        && resource.data.get('grants', []).size() == 1
        && resource.data.grants[0].get('role', '') == 'classroom'
        && myRegions().hasAny([resource.data.grants[0].get('region', '')]);
    }

    function regionDelete() {
      return isAdmin()
        && resource.data.get('grants', []).size() == 1
        && resource.data.grants[0].get('role', '') == 'classroom'
        && myRegions().hasAny([resource.data.grants[0].get('region', '')]);
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 自助註冊（只能建立自己的「待核准、無權限」）；
      // 例外：尚未 bootstrap 時允許建立第一位總管理員
      allow create: if signedIn() && request.auth.uid == uid && (
        (
          request.resource.data.superAdmin == false
          && request.resource.data.pending == true
          && request.resource.data.enabled == false
          && request.resource.data.grants.size() == 0
        )
        || (
          !bootstrapped()
          && request.resource.data.superAdmin == true
        )
      );

      allow update: if isSuper() || regionApproval() || regionToggle();
      allow delete: if isSuper() || regionDelete();
    }

    match /config/admin_root {
      allow read: if true;
      allow create: if signedIn() && !bootstrapped();
      allow update, delete: if false;
    }

    // 追加權限申請：本人可寫自己的申請；管理員可讀
    match /adminRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // 稽核紀錄：只寫不改不刪；學員端不寫入
    match /auditLogs/{logId} {
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isSuper();
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /phones/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /regions/{region} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /regions/{region}/students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 學習進度：學員端寫入，維持開放
    match /regions/{region}/students/{studentId}/progress/{courseId} {
      allow read, write: if true;
    }
  }
}
