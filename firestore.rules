rules_version = '2';

// ============================================================
// 防君子模式：所有資料可讀可寫。
//
// 原因：本系統沒有伺服器、也沒有 Firebase Auth。管理權限只在
// 前端用密碼區分，所以資料庫無法分辨「誰是管理員」。與其寫一套
// 看起來嚴格但實際擋不住的規則，這裡直接開放，並在其他地方補強：
//   - 課程有「匯出備份／匯入備份」
//   - 管理員名單看得到帳號，忘記密碼由課程管理員改
//
// 若日後要真正防護，唯一辦法是把寫入改由伺服器（Vercel Function
// 或 Cloud Functions）以 Admin SDK 執行，屆時把這裡改成
// allow write: if false;
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
