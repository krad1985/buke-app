rules_version = '2';

// ============================================================
// 管理端使用 Firebase Auth（電子郵件＋密碼）
//   - 只有 admins/{uid} 存在、enabled、且非 pending 的人能改資料
//   - 學員端維持免登入：課程、名單、系列、設定可讀；進度可讀可寫
//   - 首次建立總管理員靠 config/admin_root 標記（貼完規則請立刻建立）
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().enabled == true
        && adminDoc().pending != true;
    }
    function isSuper() {
      return isAdmin() && adminDoc().superAdmin == true;
    }
    function bootstrapped() {
      return exists(/databases/$(database)/documents/config/admin_root);
    }

    // 管理員名單
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // 自助註冊：只能建立自己的、且必須是「待核准、無權限」
      // 例外：尚未 bootstrap 時，允許建立第一位總管理員
      allow create: if signedIn() && request.auth.uid == uid && (
        (
          request.resource.data.superAdmin == false
          && request.resource.data.pending == true
          && request.resource.data.enabled == false
          && request.resource.data.grants.size() == 0
        )
        || (
          !bootstrapped()
          && request.resource.data.superAdmin == true
        )
      );

      allow update, delete: if isSuper();
    }

    // 首次建立總管理員的標記
    match /config/admin_root {
      allow read: if true;
      allow create: if signedIn() && !bootstrapped();
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 登入索引：學員要能單筆查（知道代碼或手機），不能列舉
    match /phones/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /regions/{region} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /regions/{region}/students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 學習進度：學員端寫入，維持開放（防君子）
    match /regions/{region}/students/{studentId}/progress/{courseId} {
      allow read, write: if true;
    }
  }
}
