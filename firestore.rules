rules_version = '2';

// ============================================================
// 防君子模式：所有資料可讀可寫。
//
// 本系統沒有伺服器、也沒有 Firebase Auth，管理權限只在畫面上用
// 密碼與角色區分，資料庫無法分辨誰是誰。與其寫一套看起來嚴格
// 但擋不住的規則，這裡直接開放，並用備份與角色畫面降低誤用。
//
// 這版是「全開一條規則」，之後新增集合（series、config…）不需要
// 再改規則。
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
